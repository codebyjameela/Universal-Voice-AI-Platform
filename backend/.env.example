# ==============================================================================
# UNIVERSAL VOICE AI PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:3000
NODE_ENV=development

# OpenRouter Configuration (PRIMARY AI LAYER)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Model Selection (e.g., openrouter/auto, meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-001)
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# Database (PostgreSQL + pgvector for RAG)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_ai_db
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_ai_db

# Speech-to-Text & Text-to-Speech (Pluggable providers)
# Browser Web Speech API is supported out-of-the-box with zero keys required!
# Server STT/TTS (Whisper, Groq, ElevenLabs, Deepgram) can be configured here:
STT_PROVIDER=browser
STT_API_KEY=
TTS_PROVIDER=browser
TTS_API_KEY=

# Security & JWT
JWT_SECRET=super-secret-voice-ai-platform-jwt-token-key-change-in-prod
